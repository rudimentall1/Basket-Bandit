/*
 * style.css
 * -----------------------------------------------------------------------
 * Basket Bandit
 * Classic arcade "Nu, Pogodi!" inspired visual style
 *
 * Bright cartoon colors:
 * - sky background
 * - arcade HUD
 * - big buttons
 * - mobile portrait layout
 * -----------------------------------------------------------------------
 */


:root {

  --sky-top: #6ed8ff;
  --sky-bottom: #b9f0ff;

  --grass: #55bd4a;

  --wood: #d88b35;

  --yellow: #ffd83d;
  --yellow-dark: #e3a900;

  --red: #ef3f45;

  --white: #ffffff;

  --text-dark: #382100;

  --panel: rgba(255,255,255,0.92);

  --shadow:
    0 8px 25px rgba(0,0,0,0.25);


  --radius: 24px;


  --font-stack:
    'Arial Rounded MT Bold',
    'Trebuchet MS',
    Arial,
    sans-serif;

}



* {
  box-sizing: border-box;
}



html,
body {

  margin:0;

  padding:0;

  width:100%;

  height:100%;

  overflow:hidden;


  font-family:var(--font-stack);

  user-select:none;

  -webkit-user-select:none;

}



body {


  background:
    linear-gradient(
      180deg,
      var(--sky-top),
      var(--sky-bottom)
    );

}





#game-shell {


  position:fixed;

  inset:0;


  display:flex;

  justify-content:center;

  align-items:center;


  overflow:hidden;


}



#canvas-wrap {


  position:relative;


  width:100%;

  height:100%;


  display:flex;

  justify-content:center;

  align-items:center;


}



#stage {


  position:relative;

}



#game-canvas {


  position:absolute;

  inset:0;


  width:100%;

  height:100%;


  display:block;


  touch-action:none;


  background:#8edcff;


}





#ui-root {


  position:absolute;

  inset:0;


  pointer-events:none;


  font-family:var(--font-stack);

}





/*
 ===============================
 HUD
 ===============================
*/


.hud {


  position:absolute;


  top:0;

  left:0;

  right:0;


  padding:18px;


  pointer-events:none;


}



.hud-row {


  display:flex;

  align-items:center;


}



.hud-lives {


  display:flex;

  gap:5px;


}



.hud-lives span {


  font-size:32px!important;


  color:#ff3333!important;


  text-shadow:

    2px 3px 0 white,

    0 4px 8px rgba(0,0,0,.3);


}



.hud-score {


  flex:1;


  text-align:center;


  font-size:

    clamp(32px,8vw,55px);


  font-weight:900;


  color:white;


  text-shadow:

    3px 3px 0 #995900,

    0 5px 10px rgba(0,0,0,.3);


}



.hud-score span {


  display:block;


}



.hud-score span:last-child {


  font-size:18px;


  color:#fff;


}





.hud-combo {


  text-align:center;


  font-size:20px;


  font-weight:900;


  color:#fff;


  text-shadow:

    2px 2px 0 #b36b00;


  opacity:0;


}



.hud-combo--active {


  opacity:1;


}



.icon-btn {


  pointer-events:auto;


  width:48px;

  height:48px;


  border-radius:50%;


  border:3px solid white;


  background:#3db7ff;


  color:white;


  font-size:24px;


  box-shadow:var(--shadow);


}





.icon-btn:active {


  transform:scale(.9);


}





/*
 ===============================
 MENUS
 ===============================
*/



.screen {


  position:absolute;


  inset:0;


  display:flex;


  align-items:center;


  justify-content:center;


  padding:20px;


  background:

    rgba(0,120,180,.25);


  pointer-events:auto;


}




.menu-card {


  width:100%;


  max-width:390px;


  padding:28px;


  text-align:center;


  background:

    var(--panel);


  border-radius:var(--radius);


  border:

    5px solid white;


  box-shadow:var(--shadow);


}




.menu-portrait {


  width:150px;


  margin:auto;


  display:block;


  filter:

    drop-shadow(0 8px 10px rgba(0,0,0,.3));


}





.game-title {


  margin-top:10px;


  font-size:42px;


  font-weight:900;


  color:#ff7b00;


  text-shadow:

    3px 3px 0 #ffe36b;


}




.game-sub {


  color:#744000;


  font-size:18px;


  font-weight:bold;


}





.menu-stat {


  color:#684000;


  font-weight:bold;


  margin:15px;


}




/*
 ===============================
 BUTTONS
 ===============================
*/


.btn {


  width:100%;


  margin-top:12px;


  padding:16px;


  border-radius:18px;


  border:4px solid white;


  font-size:22px;


  font-weight:900;


  cursor:pointer;


}




.btn--primary {


  background:

    linear-gradient(
      #ffe96a,
      #ffad00
    );


  color:#6b3900;


  box-shadow:

    0 7px 0 #bd7200,

    var(--shadow);


}




.btn--ghost {


  background:#4dbdff;


  color:white;


}





.btn:active {


  transform:translateY(4px);


  box-shadow:none;


}






.gameover-score,
.gameover-best {


  font-size:25px;


  font-weight:900;


  color:#ff8a00;


  margin:10px;


}





.achievement-toasts {


  color:#704000;


  font-weight:bold;


}






@media(max-height:700px){


.menu-card {


  transform:scale(.85);


}



}
